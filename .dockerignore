# What never belongs in the build context.
#
# Two reasons things are listed here: secrets that must not end up in an image
# layer, and files that would either bloat the context or be rebuilt anyway.

# Installed in the image by `npm ci`, from the lockfile. Copying the host's
# tree would also carry host-platform native binaries into a Linux image.
node_modules
**/node_modules

# Build output. The image runs its own build; a stale .next from the host would
# be copied in and then overwritten, or worse, partially reused.
.next
out
build
dist
.next-verify

# Secrets. .env.local holds the Supabase service role key and every AI provider
# key — it is passed at runtime with --env-file instead, so it must never be
# baked into a layer. .env.example is documentation and is excluded only
# because the image has no use for it.
.env
.env.*
!.env.example

# Git metadata: large, and of no use to the build.
.git
.gitignore
.github

# Editor and OS noise.
.vscode
.idea
.DS_Store
Thumbs.db
*.swp

# Docker's own files: including them would invalidate the cache on every edit.
Dockerfile
.dockerignore
docker-compose*.yml

# Local logs and caches.
npm-debug.log*
yarn-error.log*
*.log
.cache

# Documentation and SQL. supabase/schema.sql is run by hand in the Supabase SQL
# editor, not by the container, and the app never reads it at runtime.
README.md
supabase

# TypeScript build info, regenerated by the build.
*.tsbuildinfo
