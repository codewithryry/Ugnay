{
  "name": "ugnay",
  "version": "0.11.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "build:android:web": "node scripts/build-android-web.mjs",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "android:sync": "npm run build:android:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk:debug": "npm run android:sync && node scripts/gradle.mjs assembleDebug",
    "android:apk": "npm run android:sync && node scripts/gradle.mjs assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@openrouter/sdk": "^1.2.44",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.451.0",
    "next": "~15.5.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  }
}
